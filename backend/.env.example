# ============================================================
# Sovereign AI Workbench — Environment Configuration
# All inference must remain LOCAL. Do not add cloud API keys.
# ============================================================

# --- Ollama Runtime ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_TAGS_URL=http://localhost:11434/api/tags

# --- Generic fallback model (used by /chat and legacy endpoints) ---
OLLAMA_MODEL=qwen2.5vl:3b

# --- Per-capability model selection (P0 multi-model architecture) ---
# Vision/OCR Model: multimodal, handles scanned PDFs and images
# Must support image payloads via Ollama's "images" field
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Reasoning Model: instruction-following, SOP grounding, knowledge synthesis
# Text-only model is fine here; does NOT need multimodal capability
OLLAMA_REASONING_MODEL=qwen2.5:7b

# Coding Model: code generation, deterministic calculation scripts
# Should be a code-specialised model
OLLAMA_CODING_MODEL=qwen2.5-coder:7b

# NOTE: Final production model selection depends on available GPU VRAM.
# For low-VRAM setups (<=8 GB), use 3b variants for all three roles:
#   OLLAMA_REASONING_MODEL=qwen2.5:3b
#   OLLAMA_CODING_MODEL=qwen2.5-coder:3b

# --- Storage ---
SOVEREIGN_DATA_DIR=./data

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional: local Whisper model for audio (unused in core workflow) ---
WHISPER_MODEL=base
